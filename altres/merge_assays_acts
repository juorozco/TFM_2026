from chembl_webresource_client.new_client import new_client
import pandas as pd
import matplotlib.pyplot as plt

df_acts = pd.read_csv("data/total_activities.csv")
df_assay_acts = pd.read_csv("data/total_assay_acts.csv")

print(len(df_acts))
print(len(df_assay_acts))

duplicates_acts = df_acts.duplicated(
    ['molecule_chembl_id', 'target_chembl_id', 'pchembl_value', 'standard_value', 'standard_type'],
    keep=False
).sum()
print("Duplicats acts:", duplicates_acts)

duplicates = df_assay_acts.duplicated(
    ['assay_chembl_id','molecule_chembl_id', 'target_chembl_id', 'pchembl_value'],
    keep=False
).sum()
print("Duplicats:", duplicates)

df_acts_clean = df_acts.drop_duplicates(
    subset=['molecule_chembl_id', 'target_chembl_id', 'pchembl_value', 'standard_value', 'standard_type']
)

df_assay_acts_clean = df_assay_acts.drop_duplicates(
    subset=['assay_chembl_id','molecule_chembl_id', 'target_chembl_id', 'pchembl_value']
)

df_final = df_acts_clean.merge(
    df_assay_acts_clean[['molecule_chembl_id', 'target_chembl_id', 'pchembl_value', 'assay_chembl_id']],
    on=['molecule_chembl_id', 'target_chembl_id', 'pchembl_value'],
    how='left'
)

df_final.to_csv("data/db_final.csv", index=False)

print("Files df_final:", len(df_final))

# Comprovar duplicats 1:1
duplicates_final = df_final.duplicated(
    ['molecule_chembl_id', 'target_chembl_id', 'pchembl_value','standard_value', 'standard_type','assay_chembl_id']
).sum()
print("Duplicats 1:1:", duplicates_final)
# Quants assay_id són NaN
print("Assay missing:", df_final['assay_chembl_id'].isna().sum())


